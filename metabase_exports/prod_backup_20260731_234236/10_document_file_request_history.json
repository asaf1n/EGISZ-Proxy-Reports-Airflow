          },
          {
            "enabled": true,
            "name": "Наименование СЭМД"
          },
          {
            "enabled": true,
            "name": "LOGID запроса"
          },
          {
            "enabled": true,
            "name": "MSGID"
          },
          {
            "enabled": true,
            "name": "Следующий LOGID"
          },
          {
