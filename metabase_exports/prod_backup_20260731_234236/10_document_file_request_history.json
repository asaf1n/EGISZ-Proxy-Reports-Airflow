{
  "name": "История запроса документов",
  "width": "full",
  "description": "История getDocumentFile-запросов по уже зарегистрированным ЭМД. Эти события не являются подачей документа и не входят в «Отправленные без ответа».",
  "parameters": [
    {
      "id": "dfr-a1b2c3d4-e5f6-4789-a01b-0123456789ab",
      "name": "Дата запроса",
      "slug": "request_at_filter",
      "type": "date/all-options",
      "sectionId": "date",
      "default": "thismonth"
    },
    {
      "id": "dfr-e3c4d5e6-f7a8-4901-c234-56789abcdef0",
      "name": "Клиника",
      "slug": "jid_filter",
      "type": "string/=",
      "sectionId": "string"
    },
    {
      "id": "dfr-d2b3c4d5-e6f7-4890-b123-456789abcdef",
