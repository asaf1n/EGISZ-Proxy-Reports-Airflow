  ],
  "cards": [
    {
      "name": "Запросов документов",
      "description": "Количество getDocumentFile-запросов, где payload содержит emdrId.",
      "dataset_query": {
        "type": "native",
        "native": {
          "query": "SELECT COUNT(DISTINCT request_logid)::bigint AS \"Запросов\" FROM public.rpt_document_file_request WHERE 1=1 [[AND {{request_at}}]] [[AND {{jid}}]] [[AND {{semd_type}}]] [[AND {{local_uid}}]] [[AND {{emdr_id}}]]",
          "template-tags": {
            "request_at": {
              "widget-type": "date/all-options",
              "display-name": "Дата запроса",
              "id": "dfr-card-001-filter-001",
              "name": "request_at",
              "type": "dimension"
            },
            "emdr_id": {
              "widget-type": "string/=",
              "display-name": "Рег. Номер РЭМД",
              "id": "dfr-card-001-filter-005",
              "name": "emdr_id",
              "type": "dimension"
            },
            "jid": {
              "widget-type": "string/=",
              "display-name": "Клиника",
              "id": "dfr-card-001-filter-002",
              "name": "jid",
              "type": "dimension"
            },
            "local_uid": {
              "widget-type": "string/=",
              "display-name": "localUid СЭМД",
              "id": "dfr-card-001-filter-004",
              "name": "local_uid",
              "type": "dimension"
            },
            "semd_type": {
              "widget-type": "string/=",
              "display-name": "Тип СЭМД",
              "id": "dfr-card-001-filter-003",
              "name": "semd_type",
              "type": "dimension"
            }
          }
        },
        "database": 1
      },
      "display": "scalar",
      "visualization_settings": {
        "scalar.field": "Запросов"
      },
      "sizeX": 6,
      "sizeY": 3,
      "row": 0,
      "col": 0
    },
    {
      "name": "Запросы по дням",
      "description": "Динамика getDocumentFile-запросов с emdrId.",
      "dataset_query": {
        "type": "native",
        "native": {
          "query": "SELECT request_at::date AS \"Дата\", COUNT(DISTINCT request_logid)::bigint AS \"Запросов\" FROM public.rpt_document_file_request WHERE request_at IS NOT NULL [[AND {{request_at}}]] [[AND {{jid}}]] [[AND {{semd_type}}]] [[AND {{local_uid}}]] [[AND {{emdr_id}}]] GROUP BY 1 ORDER BY 1",
          "template-tags": {
            "request_at": {
              "widget-type": "date/all-options",
              "display-name": "Дата запроса",
              "id": "dfr-card-002-filter-001",
              "name": "request_at",
              "type": "dimension"
            },
            "emdr_id": {
              "widget-type": "string/=",
              "display-name": "Рег. Номер РЭМД",
              "id": "dfr-card-002-filter-005",
              "name": "emdr_id",
              "type": "dimension"
            },
            "jid": {
              "widget-type": "string/=",
              "display-name": "Клиника",
              "id": "dfr-card-002-filter-002",
              "name": "jid",
              "type": "dimension"
            },
            "local_uid": {
              "widget-type": "string/=",
              "display-name": "localUid СЭМД",
              "id": "dfr-card-002-filter-004",
              "name": "local_uid",
              "type": "dimension"
            },
            "semd_type": {
              "widget-type": "string/=",
              "display-name": "Тип СЭМД",
              "id": "dfr-card-002-filter-003",
              "name": "semd_type",
              "type": "dimension"
            }
          }
        },
        "database": 1
      },
      "display": "bar",
      "visualization_settings": {
        "graph.dimensions": [
          "Дата"
        ],
        "graph.label_value_formatting": "compact",
        "graph.show_values": true,
        "graph.x_axis.scale": "timeseries",
        "column_settings": {
          "[\"name\",\"Запросов\"]": {
            "column_title": "Запросов",
            "decimals": 0,
            "number_separators": ", "
          }
        },
        "graph.metrics": [
          "Запросов"
        ]
      },
      "sizeX": 18,
      "sizeY": 6,
      "row": 0,
      "col": 6
    },
    {
      "name": "История запросов документов",
      "description": "Последние getDocumentFile-запросы с emdrId. Следующий LOGID показан только как диагностический сосед, а не как ключ связывания.",
      "dataset_query": {
        "type": "native",
        "native": {
          "query": "SELECT request_at AS \"Дата запроса\", clinic_label AS \"Клиника\", clinic_jid AS \"JID Клиники\", semd_local_uid AS \"localUid СЭМД\", emdr_id AS \"Рег. Номер РЭМД\", semd_code AS \"Код СЭМД\", semd_name AS \"Наименование СЭМД\", request_logid AS \"LOGID запроса\", msgid AS \"MSGID\", next_logid AS \"Следующий LOGID\", next_action AS \"Следующий метод\", existing_document_status AS \"Статус найденного документа\" FROM public.rpt_document_file_request WHERE 1=1 [[AND {{request_at}}]] [[AND {{jid}}]] [[AND {{semd_type}}]] [[AND {{local_uid}}]] [[AND {{emdr_id}}]] ORDER BY request_at DESC NULLS LAST, request_logid DESC LIMIT 500",
          "template-tags": {
            "request_at": {
              "widget-type": "date/all-options",
              "display-name": "Дата запроса",
              "id": "dfr-card-003-filter-001",
              "name": "request_at",
              "type": "dimension"
            },
            "emdr_id": {
              "widget-type": "string/=",
              "display-name": "Рег. Номер РЭМД",
              "id": "dfr-card-003-filter-005",
              "name": "emdr_id",
              "type": "dimension"
            },
            "jid": {
              "widget-type": "string/=",
              "display-name": "Клиника",
              "id": "dfr-card-003-filter-002",
              "name": "jid",
              "type": "dimension"
            },
            "local_uid": {
              "widget-type": "string/=",
              "display-name": "localUid СЭМД",
              "id": "dfr-card-003-filter-004",
              "name": "local_uid",
              "type": "dimension"
            },
            "semd_type": {
              "widget-type": "string/=",
              "display-name": "Тип СЭМД",
              "id": "dfr-card-003-filter-003",
              "name": "semd_type",
              "type": "dimension"
            }
          }
        },
        "database": 1
      },
      "display": "table",
      "visualization_settings": {
        "table.columns": [
