# Артефакты сборки: dist/egisz-bi собирается scripts/build_external_bundle.ps1 из
# канонических исходников. Копии кода в git не хранятся — расхождение копии с исходником
# и было причиной устаревания прежнего варианта переноса.
#dist/

# Рабочее место оператора: прод-адреса контуров, в переносимый пакет не входит
/deploy

# Снимки живого контура перед импортом (export_dashboard.py --backup): страховка на
# момент выката, а не история проекта. Каждый снимок — тысячи строк дампа дашбордов,
# в репозитории они забивают diff и не несут смысла — состояние описывают
# metabase_dashboards/.
/metabase_exports

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local secrets and k8s connection files (use *.example.yaml / *.example.json as template)
k8s/**/**secret*.yaml
!k8s/**/**.example.yaml
k8s/airflow/egisz-connections.json

# Per-machine agent/IDE config
.claude/
.cursor/

# Ad-hoc local scripts and verification output
tmp_*.txt
tmp_*.sql
scripts/_*
profile_cold*.log
tests/.pytest_airflow.db

# Runtime logs and local Airflow artifacts
*.log
.dwh-init.last.log
airflow/logs/
