    {
      "name": "Клиники с сопоставлением НСИ",
      "description": "Клиники из JPERSONS, для которых заполнен OID НСИ. Наименование CASH берётся из JPERSONS; наименование НСИ — из отдельного поля сопоставления, если оно загружено.",
      "dataset_query": {
        "type": "native",
        "native": {
          "query": "SELECT jid AS \"JID\", COALESCE(NULLIF(btrim(cash_name), ''), '—') AS \"Наименование CASH\", COALESCE(NULLIF(btrim(nsi_name), ''), '—') AS \"Наименование НСИ\", COALESCE(NULLIF(btrim(inn), ''), '—') AS \"ИНН\", COALESCE(NULLIF(btrim(oid), ''), '—') AS \"OID\", last_success_registered_at AS \"Дата последней успешной регистрации ЭМД\" FROM public.rpt_clinic_nsi_mapping WHERE is_mapped [[AND {{clinic_jid}}]] [[AND {{cash_name}}]] [[AND {{nsi_name}}]] [[AND {{inn}}]] [[AND {{oid}}]] ORDER BY jid",
          "template-tags": {
            "clinic_jid": {
              "widget-type": "string/=",
              "display-name": "JID",
              "id": "09c10000-0000-4000-8000-000000000001",
